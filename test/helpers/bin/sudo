#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${BATS_MOCK_STATE_DIR:-/tmp/bootstrap-bats-state}"
mkdir -p "${STATE_DIR}"

case "${1:-}" in
  -v)
    exit 0
    ;;
  enable)
    if [[ "${2:-}" == "tailscaled" ]]; then
      touch "${STATE_DIR}/tailscaled-enabled"
    fi
    ;;
  start)
    if [[ "${2:-}" == "tailscaled" ]]; then
      touch "${STATE_DIR}/tailscaled-active"
    fi
    ;;
  curl)
    shift
    dest=""
    args=("$@")
    i=0
    while [[ $i -lt ${#args[@]} ]]; do
      if [[ "${args[$i]}" == "-o" && $((i + 1)) -lt ${#args[@]} ]]; then
        dest="${args[$((i + 1))]}"
      fi
      i=$((i + 1))
    done
    if [[ "${dest}" == *"tailscale.repo" ]]; then
      mkdir -p "$(dirname "${dest}")"
      touch "${dest}"
      touch "${STATE_DIR}/tailscale-repo"
      exit 0
    fi
    exec curl "$@"
    ;;
  systemctl)
    shift
    exec systemctl "$@"
    ;;
  dnf)
    shift
    exec dnf "$@"
    ;;
  tailscale)
    shift
    exec tailscale "$@"
    ;;
  set)
    shift
    exec tailscale set "$@"
    ;;
  up)
    shift
    exec tailscale up "$@"
    ;;
  *)
    echo "mock sudo unsupported: $*" >&2
    exit 1
    ;;
esac
