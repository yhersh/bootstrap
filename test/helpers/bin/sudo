#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${BATS_MOCK_STATE_DIR:-/tmp/bootstrap-bats-state}"
mkdir -p "${STATE_DIR}"

case "${1:-}" in
  -v)
    exit 0
    ;;
  enable)
    if [[ "${2:-}" == "tailscaled" ]]; then
      touch "${STATE_DIR}/tailscaled-enabled"
    fi
    ;;
  start)
    if [[ "${2:-}" == "tailscaled" ]]; then
      touch "${STATE_DIR}/tailscaled-active"
    fi
    ;;
  curl)
    shift
    dest=""
    args=("$@")
    i=0
    while [[ $i -lt ${#args[@]} ]]; do
      if [[ "${args[$i]}" == "-o" && $((i + 1)) -lt ${#args[@]} ]]; then
        dest="${args[$((i + 1))]}"
      fi
      i=$((i + 1))
    done
    if [[ "${dest}" == *"tailscale.repo" ]]; then
      mkdir -p "$(dirname "${dest}")"
      cat >"${dest}" <<'EOF'
[tailscale-stable]
name=Tailscale stable
baseurl=https://pkgs.tailscale.com/stable/fedora/$basearch
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://pkgs.tailscale.com/stable/fedora/repo.gpg
enabled=1
EOF
      touch "${STATE_DIR}/tailscale-repo"
      exit 0
    fi
    exec curl "$@"
    ;;
  systemctl)
    shift
    exec systemctl "$@"
    ;;
  dnf)
    shift
    exec dnf "$@"
    ;;
  tailscale)
    shift
    exec tailscale "$@"
    ;;
  install)
    shift
    mode="0644"
    dest=""
    src=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -m)
          mode="$2"
          shift 2
          ;;
        -o | -g)
          shift 2
          ;;
        *)
          if [[ -z "${src}" ]]; then
            src="$1"
          else
            dest="$1"
          fi
          shift
          ;;
      esac
    done
    if [[ -z "${src}" || -z "${dest}" ]]; then
      echo "mock sudo install: missing source or destination" >&2
      exit 1
    fi
    mkdir -p "$(dirname "${dest}")"
    cp "${src}" "${dest}"
    chmod "${mode}" "${dest}"
    if [[ "${dest}" == *"tailscale.repo" ]]; then
      touch "${STATE_DIR}/tailscale-repo"
    fi
    ;;
  set)
    shift
    exec tailscale set "$@"
    ;;
  up)
    shift
    exec tailscale up "$@"
    ;;
  brew)
    shift
    exec brew "$@"
    ;;
  *)
    echo "mock sudo unsupported: $*" >&2
    exit 1
    ;;
esac
